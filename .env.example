# ==========================================
# GetSATGo Environment Variables
# ==========================================

# Secret key for JWT session tokens (generate with: openssl rand -hex 32).
# Replace this value before deploying.
SECRET_KEY=replace-with-a-random-secret
ENVIRONMENT=development

# Database Connection URL:
# For local SQLite: sqlite:///./getsatgo.db
# For PostgreSQL (Render / Supabase / Neon / Railway / AWS RDS):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./getsatgo.db
# Required by Docker Compose:
POSTGRES_PASSWORD=

# Frontend API URL (only needed if frontend is hosted on a separate domain like Vercel):
# VITE_API_URL=https://api.yourdomain.com/api
VITE_MIXPANEL_TOKEN=
# Google OAuth web client ID (also set as VITE_GOOGLE_CLIENT_ID in frontend/.env.local).
GOOGLE_CLIENT_ID=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Teacher accounts require this invitation code. Leave empty to disable teacher registration.
TEACHER_SIGNUP_CODE=

# Bootstrap the initial administrator. Set a strong password (12+ characters,
# no more than 72 UTF-8 bytes) for first startup, then remove the password.
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=
SUPERUSER_NAME=Madhav Mittal

# Port (set automatically by cloud platforms like Render / Railway / Heroku)
PORT=8000

