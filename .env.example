# ==========================================
# GetSATGo Environment Variables
# ==========================================

# Secret key for JWT session tokens (generate with: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Connection URL:
# For local SQLite: sqlite:///./getsatgo.db
# For PostgreSQL (Render / Supabase / Neon / Railway / AWS RDS):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./getsatgo.db

# Frontend API URL (only needed if frontend is hosted on a separate domain like Vercel):
# VITE_API_URL=https://api.yourdomain.com/api

# Port (set automatically by cloud platforms like Render / Railway / Heroku)
PORT=8000

